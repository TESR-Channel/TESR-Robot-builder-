<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- {{ header }} -->
<package format="3">
  <name>{{ pkg }}</name>
  <version>0.1.0</version>
  <description>ros2_control setup for {{ d.meta.name }} ({{ p.controller_type }}) — generated by TESR Robot Builder</description>
  <maintainer email="tesrshop@gmail.com">TESR Co., Ltd.</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>{{ r.package("description") }}</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>hardware_interface</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>{{ p.controller_type.split('/')[0] }}</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
