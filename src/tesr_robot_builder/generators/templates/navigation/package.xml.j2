<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- {{ header }} -->
<package format="3">
  <name>{{ pkg }}</name>
  <version>0.1.0</version>
  <description>Nav2 + slam_toolbox for {{ d.meta.name }} — parameters sized from the robot by TESR Robot Builder</description>
  <maintainer email="tesrshop@gmail.com">TESR Co., Ltd.</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

{% for dep in ['slam_toolbox', 'nav2_controller', 'nav2_planner', 'nav2_smoother', 'nav2_behaviors', 'nav2_bt_navigator', 'nav2_velocity_smoother',
               'nav2_waypoint_follower', 'nav2_lifecycle_manager', 'nav2_map_server', 'nav2_amcl', 'nav2_mppi_controller', 'nav2_smac_planner',
               'nav2_costmap_2d', 'rviz2'] %}
  <exec_depend>{{ dep }}</exec_depend>
{% endfor %}

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
