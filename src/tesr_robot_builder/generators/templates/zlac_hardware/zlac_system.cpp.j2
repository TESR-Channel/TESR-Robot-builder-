namespace reg
{
// ZLAC8015D RS485 Communication Instruction V1.04
constexpr uint16_t WATCHDOG = 0x2000;      // communication offline time, ms (motor stops if the PC goes quiet)
constexpr uint16_t MODE = 0x200D;          // 3 = velocity mode
constexpr uint16_t CONTROL = 0x200E;       // 0x05 quick stop, 0x06 clear fault, 0x07 stop, 0x08 enable
constexpr uint16_t ACCEL_L = 0x2080;       // 0x2080..0x2083: accel L, accel R, decel L, decel R (ms)
constexpr uint16_t TARGET_RPM_L = 0x2088;  // 0x2088 L, 0x2089 R: target speed, rpm (int16)
constexpr uint16_t STATUS = 0x20A5;        // 0x20A5..0x20AC: fault L, fault R, pos L hi/lo, pos R hi/lo, rpm×10 L, rpm×10 R
constexpr uint16_t STATUS_LEN = 8;
constexpr uint16_t VELOCITY_MODE = 3, ENABLE = 0x08, STOP = 0x07, CLEAR_FAULT = 0x06;
}  // namespace reg

namespace
{
template<class Map>
int param_int(const Map & p, const std::string & k, int def)
{
  auto it = p.find(k);
  return it == p.end() ? def : std::stoi(it->second);
}
template<class Map>
double param_double(const Map & p, const std::string & k, double def)
{
  auto it = p.find(k);
  return it == p.end() ? def : std::stod(it->second);
}
template<class Map>
bool param_bool(const Map & p, const std::string & k, bool def)
{
  auto it = p.find(k);
  if (it == p.end()) {return def;}
  return it->second == "true" || it->second == "True" || it->second == "1";
}
const char * fault_text(uint16_t f)
{
  static const std::pair<uint16_t, const char *> bits[] = {
    {0x0001, "over-voltage"}, {0x0002, "under-voltage"}, {0x0004, "over-current"}, {0x0008, "overload"},
    {0x0010, "current following error"}, {0x0020, "position following error"}, {0x0040, "speed following error"},
    {0x0080, "reference voltage error"}, {0x0100, "EEPROM error"}, {0x0200, "Hall sensor error"},
    {0x0400, "motor over-temperature"}};
  for (auto & b : bits) {
    if (f & b.first) {return b.second;}
  }
  return "unknown fault";
}
constexpr double RPM_TO_RAD = 2.0 * M_PI / 60.0;
}  // namespace

hardware_interface::CallbackReturn ZlacSystem::on_init(const hardware_interface::HardwareInfo & info)
{
  if (hardware_interface::SystemInterface::on_init(info) != CallbackReturn::SUCCESS) {
    return CallbackReturn::ERROR;
  }
  const auto & hp = info_.hardware_parameters;
  auto it = hp.find("port");
  if (it != hp.end()) {port_ = it->second;}
  baud_ = param_int(hp, "baud", baud_);
  timeout_ms_ = param_int(hp, "timeout_ms", timeout_ms_);
  accel_ms_ = param_int(hp, "accel_ms", accel_ms_);
  decel_ms_ = param_int(hp, "decel_ms", decel_ms_);
  watchdog_ms_ = param_int(hp, "watchdog_ms", watchdog_ms_);
  max_rpm_ = param_int(hp, "max_rpm", max_rpm_);
  max_comm_errors_ = param_int(hp, "max_comm_errors", max_comm_errors_);
  counts_per_rev_ = param_double(hp, "counts_per_rev", counts_per_rev_);

  std::set<int> nodes;
  for (const auto & j : info_.joints) {
    if (j.command_interfaces.size() != 1 || j.command_interfaces[0].name != hardware_interface::HW_IF_VELOCITY) {
      RCLCPP_FATAL(log_, "joint %s: needs exactly one velocity command interface", j.name.c_str());
      return CallbackReturn::ERROR;
    }
    Wheel w;
    w.joint = j.name;
    w.node_id = param_int(j.parameters, "node_id", 1);
    const auto ch = j.parameters.count("channel") ? j.parameters.at("channel") : std::string("left");
    if (ch != "left" && ch != "right") {
      RCLCPP_FATAL(log_, "joint %s: channel must be left or right, got '%s'", j.name.c_str(), ch.c_str());
      return CallbackReturn::ERROR;
    }
    w.channel = ch == "right" ? 1 : 0;
    w.sign = param_bool(j.parameters, "invert", false) ? -1.0 : 1.0;
    wheels_.push_back(w);
    nodes.insert(w.node_id);
  }
  nodes_.assign(nodes.begin(), nodes.end());
  std::ostringstream os;
  for (const auto & w : wheels_) {
    os << " " << w.joint << "=node" << w.node_id << (w.channel ? "/R" : "/L") << (w.sign < 0 ? "(inv)" : "");
  }
  RCLCPP_INFO(log_, "ZLAC on %s @ %d baud:%s", port_.c_str(), baud_, os.str().c_str());
  return CallbackReturn::SUCCESS;
}

hardware_interface::CallbackReturn ZlacSystem::on_configure(const rclcpp_lifecycle::State &)
{
  if (!bus_.open(port_, baud_, timeout_ms_)) {
    RCLCPP_FATAL(log_, "%s", bus_.error().c_str());
    return CallbackReturn::ERROR;
  }
  for (int id : nodes_) {
    std::vector<uint16_t> st;
    if (!bus_.read_holding(static_cast<uint8_t>(id), reg::STATUS, reg::STATUS_LEN, st)) {
      RCLCPP_FATAL(log_, "ZLAC node %d does not answer on %s (%s). Check power, A/B wiring, node id and baud rate.",
        id, port_.c_str(), bus_.error().c_str());
      bus_.close();
      return CallbackReturn::ERROR;
    }
    RCLCPP_INFO(log_, "ZLAC node %d answers (faults L=0x%04X R=0x%04X)", id, st[0], st[1]);
  }
  return CallbackReturn::SUCCESS;
}

hardware_interface::CallbackReturn ZlacSystem::on_cleanup(const rclcpp_lifecycle::State &)
{
  bus_.close();
  return CallbackReturn::SUCCESS;
}

bool ZlacSystem::setup_driver(int id)
{
  const auto u = static_cast<uint8_t>(id);
  return bus_.write_single(u, reg::CONTROL, reg::CLEAR_FAULT) &&
         bus_.write_single(u, reg::MODE, reg::VELOCITY_MODE) &&
         bus_.write_multiple(u, reg::ACCEL_L, {static_cast<uint16_t>(accel_ms_), static_cast<uint16_t>(accel_ms_),
             static_cast<uint16_t>(decel_ms_), static_cast<uint16_t>(decel_ms_)}) &&
         bus_.write_single(u, reg::WATCHDOG, static_cast<uint16_t>(watchdog_ms_)) &&
         bus_.write_multiple(u, reg::TARGET_RPM_L, {0, 0}) &&
         bus_.write_single(u, reg::CONTROL, reg::ENABLE);
}

hardware_interface::CallbackReturn ZlacSystem::on_activate(const rclcpp_lifecycle::State &)
{
  for (int id : nodes_) {
    if (!setup_driver(id)) {
      RCLCPP_FATAL(log_, "ZLAC node %d: setup failed (%s)", id, bus_.error().c_str());
      return CallbackReturn::ERROR;
    }
  }
  for (auto & w : wheels_) {
    w.cmd = 0.0; w.vel = 0.0; w.pos = 0.0; w.have_counts0 = false;
  }
  comm_errors_ = 0;
  RCLCPP_INFO(log_, "ZLAC drivers enabled in velocity mode (accel %d ms, decel %d ms, watchdog %d ms)",
    accel_ms_, decel_ms_, watchdog_ms_);
  return CallbackReturn::SUCCESS;
}

hardware_interface::CallbackReturn ZlacSystem::on_deactivate(const rclcpp_lifecycle::State &)
{
  for (int id : nodes_) {
    const auto u = static_cast<uint8_t>(id);
    bus_.write_multiple(u, reg::TARGET_RPM_L, {0, 0});
    bus_.write_single(u, reg::CONTROL, reg::STOP);
  }
  RCLCPP_INFO(log_, "ZLAC drivers stopped");
  return CallbackReturn::SUCCESS;
}

std::vector<hardware_interface::StateInterface> ZlacSystem::export_state_interfaces()
{
  std::vector<hardware_interface::StateInterface> out;
  for (auto & w : wheels_) {
    out.emplace_back(w.joint, hardware_interface::HW_IF_POSITION, &w.pos);
    out.emplace_back(w.joint, hardware_interface::HW_IF_VELOCITY, &w.vel);
  }
  return out;
}

std::vector<hardware_interface::CommandInterface> ZlacSystem::export_command_interfaces()
{
  std::vector<hardware_interface::CommandInterface> out;
  for (auto & w : wheels_) {
    out.emplace_back(w.joint, hardware_interface::HW_IF_VELOCITY, &w.cmd);
  }
  return out;
}

void ZlacSystem::report_faults(int id, uint16_t left, uint16_t right)
{
  if (left) {
    RCLCPP_ERROR_THROTTLE(log_, clock_, 2000, "ZLAC node %d left motor fault 0x%04X: %s", id, left, fault_text(left));
  }
  if (right) {
    RCLCPP_ERROR_THROTTLE(log_, clock_, 2000, "ZLAC node %d right motor fault 0x%04X: %s", id, right, fault_text(right));
  }
}

hardware_interface::return_type ZlacSystem::read(const rclcpp::Time &, const rclcpp::Duration & period)
{
  bool ok = true;
  for (int id : nodes_) {
    std::vector<uint16_t> st;
    if (!bus_.read_holding(static_cast<uint8_t>(id), reg::STATUS, reg::STATUS_LEN, st)) {
      ok = false;
      RCLCPP_WARN_THROTTLE(log_, clock_, 2000, "ZLAC node %d read: %s", id, bus_.error().c_str());
      continue;
    }
    report_faults(id, st[0], st[1]);
    const int32_t counts[2] = {
      static_cast<int32_t>((static_cast<uint32_t>(st[2]) << 16) | st[3]),
      static_cast<int32_t>((static_cast<uint32_t>(st[4]) << 16) | st[5])};
    const double rpm[2] = {static_cast<int16_t>(st[6]) / 10.0, static_cast<int16_t>(st[7]) / 10.0};
    for (auto & w : wheels_) {
      if (w.node_id != id) {continue;}
      w.vel = w.sign * rpm[w.channel] * RPM_TO_RAD;
      if (counts_per_rev_ > 0.0) {
        if (!w.have_counts0) {w.counts0 = counts[w.channel]; w.have_counts0 = true;}
        w.pos = w.sign * (counts[w.channel] - w.counts0) / counts_per_rev_ * 2.0 * M_PI;
      } else {
        w.pos += w.vel * period.seconds();
      }
    }
  }
  comm_errors_ = ok ? 0 : comm_errors_ + 1;
  if (comm_errors_ >= max_comm_errors_) {
    RCLCPP_ERROR(log_, "ZLAC: %d failed cycles in a row on %s — stopping", comm_errors_, port_.c_str());
    return hardware_interface::return_type::ERROR;
  }
  return hardware_interface::return_type::OK;
}

hardware_interface::return_type ZlacSystem::write(const rclcpp::Time &, const rclcpp::Duration &)
{
  for (int id : nodes_) {
    int16_t rpm[2] = {0, 0};
    for (const auto & w : wheels_) {
      if (w.node_id != id) {continue;}
      double r = w.sign * w.cmd / RPM_TO_RAD;
      if (!std::isfinite(r)) {r = 0.0;}
      r = std::clamp(r, -static_cast<double>(max_rpm_), static_cast<double>(max_rpm_));
      rpm[w.channel] = static_cast<int16_t>(std::lround(r));
    }
    if (!bus_.write_multiple(static_cast<uint8_t>(id), reg::TARGET_RPM_L,
        {static_cast<uint16_t>(rpm[0]), static_cast<uint16_t>(rpm[1])}))
    {
      RCLCPP_WARN_THROTTLE(log_, clock_, 2000, "ZLAC node %d write: %s", id, bus_.error().c_str());
    }
  }
  return hardware_interface::return_type::OK;
}

