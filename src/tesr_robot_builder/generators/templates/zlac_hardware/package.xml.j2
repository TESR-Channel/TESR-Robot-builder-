<?xml version="1.0"?>
<!-- {{ header }} -->
<package format="3">
  <name>tesr_zlac_hardware</name>
  <version>0.1.0</version>
  <description>ros2_control hardware interface for ZLTECH ZLAC8015D-family hub servo drivers (RS485 Modbus RTU), generated by TESR Robot Builder.</description>
  <maintainer email="tesrshop@gmail.com">TESR Co., Ltd.</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <exec_depend>python3-serial</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
