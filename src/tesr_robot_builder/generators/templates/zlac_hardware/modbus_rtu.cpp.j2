#include "tesr_zlac_hardware/modbus_rtu.hpp"

#include <fcntl.h>
#include <poll.h>
#include <termios.h>
#include <unistd.h>

#include <cerrno>
#include <chrono>
#include <cstring>

namespace tesr_zlac_hardware
{

ModbusRtu::~ModbusRtu() {close();}

static speed_t to_speed(int baud)
{
  switch (baud) {
    case 9600: return B9600;
    case 19200: return B19200;
    case 38400: return B38400;
    case 57600: return B57600;
    case 115200: return B115200;
    case 230400: return B230400;
    default: return 0;
  }
}

bool ModbusRtu::open(const std::string & port, int baud, int timeout_ms)
{
  close();
  timeout_ms_ = timeout_ms;
  const speed_t sp = to_speed(baud);
  if (sp == 0) {
    error_ = "unsupported baud rate " + std::to_string(baud) + " (use 115200, the ZLAC default)";
    return false;
  }
  fd_ = ::open(port.c_str(), O_RDWR | O_NOCTTY | O_NONBLOCK);
  if (fd_ < 0) {
    error_ = "cannot open " + port + ": " + std::strerror(errno) +
      " (is the RS485 adapter plugged in? is the user in the dialout group?)";
    return false;
  }
  termios tio{};
  if (tcgetattr(fd_, &tio) != 0) {
    error_ = "tcgetattr " + port + ": " + std::strerror(errno);
    close();
    return false;
  }
  cfmakeraw(&tio);
  cfsetispeed(&tio, sp);
  cfsetospeed(&tio, sp);
  tio.c_cflag |= (CLOCAL | CREAD);
  tio.c_cflag &= ~(PARENB | CSTOPB | CSIZE | CRTSCTS);
  tio.c_cflag |= CS8;  // 8N1, as the ZLAC drivers ship
  tio.c_cc[VMIN] = 0;
  tio.c_cc[VTIME] = 0;
  if (tcsetattr(fd_, TCSANOW, &tio) != 0) {
    error_ = "tcsetattr " + port + ": " + std::strerror(errno);
    close();
    return false;
  }
  tcflush(fd_, TCIOFLUSH);
  return true;
}

void ModbusRtu::close()
{
  if (fd_ >= 0) {
    ::close(fd_);
    fd_ = -1;
  }
}

uint16_t ModbusRtu::crc16(const uint8_t * data, size_t len)
{
  uint16_t crc = 0xFFFF;
  for (size_t i = 0; i < len; ++i) {
    crc ^= data[i];
    for (int b = 0; b < 8; ++b) {
      crc = (crc & 1) ? static_cast<uint16_t>((crc >> 1) ^ 0xA001) : static_cast<uint16_t>(crc >> 1);
    }
  }
  return crc;
}

static void append_crc(std::vector<uint8_t> & f)
{
  const uint16_t c = ModbusRtu::crc16(f.data(), f.size());
  f.push_back(static_cast<uint8_t>(c & 0xFF));
  f.push_back(static_cast<uint8_t>(c >> 8));
}

bool ModbusRtu::transact(const std::vector<uint8_t> & request, size_t expected_len, std::vector<uint8_t> & reply)
{
  if (fd_ < 0) {
    error_ = "port not open";
    return false;
  }
  tcflush(fd_, TCIFLUSH);  // drop a late answer from an earlier request
  size_t sent = 0;
  while (sent < request.size()) {
    const ssize_t n = ::write(fd_, request.data() + sent, request.size() - sent);
    if (n < 0) {
      if (errno == EAGAIN) {continue;}
      error_ = std::string("write: ") + std::strerror(errno);
      return false;
    }
    sent += static_cast<size_t>(n);
  }
  reply.clear();
  const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(timeout_ms_);
  uint8_t buf[256];
  while (reply.size() < expected_len) {
    const int left = static_cast<int>(std::chrono::duration_cast<std::chrono::milliseconds>(
        deadline - std::chrono::steady_clock::now()).count());
    if (left <= 0) {
      error_ = "timeout (" + std::to_string(reply.size()) + "/" + std::to_string(expected_len) + " bytes)";
      return false;
    }
    pollfd p{fd_, POLLIN, 0};
    const int r = ::poll(&p, 1, left);
    if (r <= 0) {continue;}
    const ssize_t n = ::read(fd_, buf, sizeof(buf));
    if (n > 0) {
      reply.insert(reply.end(), buf, buf + n);
      // exception reply: id, fc|0x80, code, crc(2) = 5 bytes
      if (reply.size() >= 5 && (reply[1] & 0x80)) {
        error_ = "modbus exception " + std::to_string(reply[2]) + " for function " + std::to_string(request[1]);
        return false;
      }
    }
  }
  reply.resize(expected_len);
  const uint16_t c = crc16(reply.data(), expected_len - 2);
  if (reply[expected_len - 2] != (c & 0xFF) || reply[expected_len - 1] != (c >> 8)) {
    error_ = "bad CRC";
    return false;
  }
  if (reply[0] != request[0] || reply[1] != request[1]) {
    error_ = "reply from the wrong node or function";
    return false;
  }
  return true;
}

bool ModbusRtu::read_holding(uint8_t id, uint16_t addr, uint16_t count, std::vector<uint16_t> & out)
{
  std::vector<uint8_t> f{id, 0x03, static_cast<uint8_t>(addr >> 8), static_cast<uint8_t>(addr & 0xFF),
    static_cast<uint8_t>(count >> 8), static_cast<uint8_t>(count & 0xFF)};
  append_crc(f);
  std::vector<uint8_t> r;
  if (!transact(f, 5 + 2 * count, r)) {return false;}
  out.resize(count);
  for (uint16_t i = 0; i < count; ++i) {
    out[i] = static_cast<uint16_t>((r[3 + 2 * i] << 8) | r[4 + 2 * i]);
  }
  return true;
}

bool ModbusRtu::write_single(uint8_t id, uint16_t addr, uint16_t value)
{
  std::vector<uint8_t> f{id, 0x06, static_cast<uint8_t>(addr >> 8), static_cast<uint8_t>(addr & 0xFF),
    static_cast<uint8_t>(value >> 8), static_cast<uint8_t>(value & 0xFF)};
  append_crc(f);
  std::vector<uint8_t> r;
  return transact(f, 8, r);
}

bool ModbusRtu::write_multiple(uint8_t id, uint16_t addr, const std::vector<uint16_t> & values)
{
  const uint16_t n = static_cast<uint16_t>(values.size());
  std::vector<uint8_t> f{id, 0x10, static_cast<uint8_t>(addr >> 8), static_cast<uint8_t>(addr & 0xFF),
    static_cast<uint8_t>(n >> 8), static_cast<uint8_t>(n & 0xFF), static_cast<uint8_t>(2 * n)};
  for (uint16_t v : values) {
    f.push_back(static_cast<uint8_t>(v >> 8));
    f.push_back(static_cast<uint8_t>(v & 0xFF));
  }
  append_crc(f);
  std::vector<uint8_t> r;
  return transact(f, 8, r);
}

}  // namespace tesr_zlac_hardware
