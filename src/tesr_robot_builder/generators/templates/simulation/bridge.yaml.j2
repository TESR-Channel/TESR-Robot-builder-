# {{ header }}
# ros_gz_bridge topics for {{ d.meta.name }} (Gazebo Harmonic <-> ROS 2 Jazzy)
- ros_topic_name: "/clock"
  gz_topic_name: "/clock"
  ros_type_name: "rosgraph_msgs/msg/Clock"
  gz_type_name: "gz.msgs.Clock"
  direction: GZ_TO_ROS
{% for s in p.lidars %}
- ros_topic_name: "{{ s.topic }}"
  gz_topic_name: "{{ s.gz_topic }}"
  ros_type_name: "sensor_msgs/msg/LaserScan"
  gz_type_name: "gz.msgs.LaserScan"
  direction: GZ_TO_ROS
{% endfor %}
{% for s in p.cameras %}
- ros_topic_name: "{{ s.topic }}/image"
  gz_topic_name: "{{ s.gz_topic }}/image"
  ros_type_name: "sensor_msgs/msg/Image"
  gz_type_name: "gz.msgs.Image"
  direction: GZ_TO_ROS
- ros_topic_name: "{{ s.topic }}/depth_image"
  gz_topic_name: "{{ s.gz_topic }}/depth_image"
  ros_type_name: "sensor_msgs/msg/Image"
  gz_type_name: "gz.msgs.Image"
  direction: GZ_TO_ROS
- ros_topic_name: "{{ s.topic }}/points"
  gz_topic_name: "{{ s.gz_topic }}/points"
  ros_type_name: "sensor_msgs/msg/PointCloud2"
  gz_type_name: "gz.msgs.PointCloudPacked"
  direction: GZ_TO_ROS
- ros_topic_name: "{{ s.topic }}/camera_info"
  gz_topic_name: "{{ s.gz_topic }}/camera_info"
  ros_type_name: "sensor_msgs/msg/CameraInfo"
  gz_type_name: "gz.msgs.CameraInfo"
  direction: GZ_TO_ROS
{% endfor %}
{% for s in p.imus %}
- ros_topic_name: "{{ s.topic }}"
  gz_topic_name: "{{ s.gz_topic }}"
  ros_type_name: "sensor_msgs/msg/Imu"
  gz_type_name: "gz.msgs.IMU"
  direction: GZ_TO_ROS
{% endfor %}
{% if p.sim_drive == 'gz_mecanum' %}
- ros_topic_name: "/cmd_vel"
  gz_topic_name: "cmd_vel"
  ros_type_name: "geometry_msgs/msg/TwistStamped"
  gz_type_name: "gz.msgs.Twist"
  direction: ROS_TO_GZ
- ros_topic_name: "/odom"
  gz_topic_name: "odom"
  ros_type_name: "nav_msgs/msg/Odometry"
  gz_type_name: "gz.msgs.Odometry"
  direction: GZ_TO_ROS
- ros_topic_name: "/tf"
  gz_topic_name: "tf"
  ros_type_name: "tf2_msgs/msg/TFMessage"
  gz_type_name: "gz.msgs.Pose_V"
  direction: GZ_TO_ROS
- ros_topic_name: "/joint_states"
  gz_topic_name: "joint_states"
  ros_type_name: "sensor_msgs/msg/JointState"
  gz_type_name: "gz.msgs.Model"
  direction: GZ_TO_ROS
{% endif %}
